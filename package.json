{
  "name": "logic",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ai knowledge blog",
  "author": "ymz",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "generate-meta": "jiti scripts/generate-metadata.ts",
    "test": "run-s test:generate-meta test:knowledge-view test:article-detail-view test:articles-data",
    "test:generate-meta": "jiti scripts/generate-metadata.test.ts",
    "test:knowledge-view": "jiti scripts/knowledge-view.test.ts",
    "test:article-detail-view": "jiti scripts/article-detail-view.test.ts",
    "test:articles-data": "jiti scripts/articles-data.test.ts",
    "prebuild": "pnpm run generate-meta",
    "predev": "pnpm run generate-meta",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "gsap": "^3.14.2",
    "lenis": "^1.3.21",
    "marked": "^17.0.5",
    "vue": "^3.5.29",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.11.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/eslint-config-typescript": "^14.7.0",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.50.0",
    "eslint-plugin-vue": "~10.8.0",
    "jiti": "^2.6.1",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.50.0",
    "prettier": "3.8.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-vue-devtools": "^8.0.6",
    "vitest": "^4.1.5",
    "vue-tsc": "^3.2.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}